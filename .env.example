# Copy this file to .env and fill it in. .env is git-ignored.

# From https://dashboard.bfl.ai (API keys)
BFL_API_KEY=

# Hard stop: the ledger refuses any paid call that would push estimated spend past this.
SPEND_CAP_USD=25

# When true, paid calls are logged but never sent. Leave on until M2.
DRY_RUN=true
